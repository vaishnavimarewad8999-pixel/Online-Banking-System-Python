# SecureBank Environment Configuration
# Copy this file to .env for local overrides, or set these in your Vercel Project Settings > Environment Variables

# Flask secret key for cryptographically signing sessions
SECRET_KEY=generate_a_secure_random_key_here

# Persistent PostgreSQL Database URL for production (e.g. Neon, Supabase, Vercel Postgres, AWS RDS)
# If omitted, SecureBank automatically falls back to local SQLite (banking.db)
DATABASE_URL=postgresql://username:password@ep-host-name.region.aws.neon.tech/banking_db?sslmode=require
